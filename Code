# =========================
# MAIN PROGRAM
# =========================

def main():
    init_db()
    conn = get_connection()

    while True:
        menu()
        choice = input("Choose option: ").strip()

        if choice == "1":
            add_student(conn)
        elif choice == "2":
            add_grade(conn)
        elif choice == "3":
            view_student_report(conn)
        elif choice == "4":
            list_students(conn)
        elif choice == "5":
            delete_student(conn)
        elif choice == "6":
            search_student(conn)
        elif choice == "7":
            edit_student_name(conn)
        elif choice == "8":
            delete_grade(conn)
        elif choice == "9":
            top_student(conn)
        elif choice == "10":
            ranking_system(conn)
        elif choice == "11":
            class_statistics(conn)
        elif choice == "12":
            honor_roll(conn)
        elif choice == "0":
            print("\nGoodbye! 👋")
            conn.close()
            break
        else:
            print("✘ Invalid choice.")


if __name__ == "__main__":
    main()
