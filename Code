import sqlite3
import os

DB_FILE = "students.db"


# =========================
# DATABASE SETUP
# =========================

def get_connection():
    conn = sqlite3.connect(DB_FILE)
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


def init_db():
    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        CREATE TABLE IF NOT EXISTS students (
            id TEXT PRIMARY KEY,
            name TEXT NOT NULL
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS grades (
            student_id TEXT NOT NULL,
            subject TEXT NOT NULL,
            grade REAL NOT NULL,
            PRIMARY KEY (student_id, subject),
            FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE
        )
    """)

    conn.commit()
    conn.close()


# =========================
# HELPER FUNCTIONS
# =========================

def divider():
    print("─" * 50)


def generate_id(conn):
    cur = conn.cursor()
    cur.execute("SELECT id FROM students")
    ids = [row[0] for row in cur.fetchall()]

    if not ids:
        return "N001"

    last_id = max(int(sid[1:]) for sid in ids)
    return f"N{last_id + 1:03d}"


def get_average(grades):
    if not grades:
        return 0
    return sum(grades.values()) / len(grades)


def get_letter_grade(avg):
    if avg >= 100:
        return "Outstanding"
    elif avg >= 90:
        return "Excellent"
    elif avg >= 80:
        return "Good"
    elif avg >= 70:
        return "Fair"
    elif avg >= 60:
        return "Poor"
    return "Failing"


def fetch_student_grades(conn, student_id):
    cur = conn.cursor()
    cur.execute(
        "SELECT subject, grade FROM grades WHERE student_id = ?",
        (student_id,)
    )
    return {subject: grade for subject, grade in cur.fetchall()}


def student_exists(conn, student_id):
    cur = conn.cursor()
    cur.execute("SELECT 1 FROM students WHERE id = ?", (student_id,))
    return cur.fetchone() is not None


# =========================
# STUDENT FUNCTIONS
# =========================

def add_student(conn):
    divider()
    print("ADD STUDENT")
    divider()

    name = input("Enter student name: ").strip()

    if not name:
        print("✘ Name cannot be empty.")
        return

    cur = conn.cursor()
    cur.execute(
        "SELECT id FROM students WHERE LOWER(name) = LOWER(?)",
        (name,)
    )
    existing = cur.fetchone()

    if existing:
        print(f"✘ Student already exists with ID {existing[0]}")
        return

    student_id = generate_id(conn)

    cur.execute(
        "INSERT INTO students (id, name) VALUES (?, ?)",
        (student_id, name)
    )
    conn.commit()

    print(f"✔ Student added successfully. ID: {student_id}")


def edit_student_name(conn):
    divider()
    print("EDIT STUDENT NAME")
    divider()

    student_id = input("Enter Student ID: ").strip().upper()

    if not student_exists(conn, student_id):
        print("✘ Student not found.")
        return

    new_name = input("Enter new name: ").strip()

    if not new_name:
        print("✘ Name cannot be empty.")
        return

    cur = conn.cursor()
    cur.execute(
        "UPDATE students SET name = ? WHERE id = ?",
        (new_name, student_id)
    )
    conn.commit()

    print("✔ Student name updated.")


def delete_student(conn):
    divider()
    print("DELETE STUDENT")
    divider()

    student_id = input("Enter Student ID: ").strip().upper()

    if not student_exists(conn, student_id):
        print("✘ Student not found.")
        return

    confirm = input("Type YES to confirm: ").upper()

    if confirm == "YES":
        cur = conn.cursor()
        cur.execute("DELETE FROM students WHERE id = ?", (student_id,))
        conn.commit()
        print("✔ Student deleted.")
    else:
        print("Cancelled.")


# =========================
# GRADE FUNCTIONS
# =========================

def add_grade(conn):
    divider()
    print("ADD / UPDATE GRADE")
    divider()

    student_id = input("Enter Student ID: ").strip().upper()

    if not student_exists(conn, student_id):
        print("✘ Student not found.")
        return

    subject = input("Enter Subject: ").strip()

    try:
        grade = float(input("Enter Grade (0-100): "))
    except ValueError:
        print("✘ Invalid grade.")
        return

    if grade < 0 or grade > 100:
        print("✘ Grade must be between 0 and 100.")
        return

    cur = conn.cursor()
    cur.execute("""
        INSERT INTO grades (student_id, subject, grade)
        VALUES (?, ?, ?)
        ON CONFLICT(student_id, subject) DO UPDATE SET grade = excluded.grade
    """, (student_id, subject, grade))
    conn.commit()

    print("✔ Grade saved.")


def delete_grade(conn):
    divider()
    print("DELETE GRADE")
    divider()

    student_id = input("Enter Student ID: ").strip().upper()

    if not student_exists(conn, student_id):
        print("✘ Student not found.")
        return

    grades = fetch_student_grades(conn, student_id)

    if not grades:
        print("No grades recorded.")
        return

    subject = input("Enter Subject to Delete: ").strip()

    if subject not in grades:
        print("✘ Subject not found.")
        return

    cur = conn.cursor()
    cur.execute(
        "DELETE FROM grades WHERE student_id = ? AND subject = ?",
        (student_id, subject)
    )
    conn.commit()

    print("✔ Grade deleted.")


# =========================
# REPORTS
# =========================

def view_student_report(conn):
    divider()
    print("STUDENT REPORT")
    divider()

    student_id = input("Enter Student ID: ").strip().upper()

    if not student_exists(conn, student_id):
        print("✘ Student not found.")
        return

    cur = conn.cursor()
    cur.execute("SELECT name FROM students WHERE id = ?", (student_id,))
    name = cur.fetchone()[0]

    print(f"\nName : {name}")
    print(f"ID   : {student_id}")

    grades = fetch_student_grades(conn, student_id)

    if not grades:
        print("\nNo grades available.")
        return

    divider()
    print(f"{'Subject':20} {'Grade':>10}")
    divider()

    for subject, grade in grades.items():
        print(f"{subject:20} {grade:>10.1f}")

    avg = get_average(grades)

    divider()
    print(f"Average: {avg:.2f}")
    print(f"Letter : {get_letter_grade(avg)}")


def list_students(conn):
    divider()
    print("ALL STUDENTS")
    divider()

    cur = conn.cursor()
    cur.execute("SELECT id, name FROM students ORDER BY id")
    students = cur.fetchall()

    if not students:
        print("No students registered.")
        return

    print(f"{'ID':<8}{'NAME':<25}{'AVG':<10}{'GRADE'}")
    divider()

    for sid, name in students:
        grades = fetch_student_grades(conn, sid)

        if grades:
            avg = get_average(grades)
            grade_letter = get_letter_grade(avg)
            avg_display = f"{avg:.2f}"
        else:
            avg_display = "-"
            grade_letter = "N/A"

        print(f"{sid:<8}{name:<25}{avg_display:<10}{grade_letter}")


def search_student(conn):
    divider()
    print("SEARCH STUDENT")
    divider()

    keyword = input("Enter student name: ").strip()

    cur = conn.cursor()
    cur.execute(
        "SELECT id, name FROM students WHERE LOWER(name) LIKE LOWER(?)",
        (f"%{keyword}%",)
    )
    results = cur.fetchall()

    if not results:
        print("No matching student found.")
        return

    for sid, name in results:
        print(f"{sid} - {name}")


def top_student(conn):
    divider()
    print("TOP PERFORMING STUDENT")
    divider()

    cur = conn.cursor()
    cur.execute("SELECT id, name FROM students")
    students = cur.fetchall()

    ranked = []
    for sid, name in students:
        grades = fetch_student_grades(conn, sid)
        if grades:
            ranked.append((get_average(grades), sid, name))

    if not ranked:
        print("No grades available.")
        return

    ranked.sort(reverse=True)
    avg, sid, name = ranked[0]

    print(f"Name    : {name}")
    print(f"ID      : {sid}")
    print(f"Average : {avg:.2f}")
    print(f"Grade   : {get_letter_grade(avg)}")


def ranking_system(conn):
    divider()
    print("CLASS RANKING")
    divider()

    cur = conn.cursor()
    cur.execute("SELECT id, name FROM students")
    students = cur.fetchall()

    ranked = []
    for sid, name in students:
        grades = fetch_student_grades(conn, sid)
        if grades:
            ranked.append((get_average(grades), sid, name))

    if not ranked:
        print("No grades available.")
        return

    ranked.sort(reverse=True)

    print(f"{'Rank':<6}{'ID':<8}{'Name':<25}{'Average'}")
    divider()

    for rank, (avg, sid, name) in enumerate(ranked, start=1):
        print(f"{rank:<6}{sid:<8}{name:<25}{avg:.2f}")


def class_statistics(conn):
    divider()
    print("CLASS STATISTICS")
    divider()

    cur = conn.cursor()
    cur.execute("SELECT id FROM students")
    student_ids = [row[0] for row in cur.fetchall()]

    averages = []
    for sid in student_ids:
        grades = fetch_student_grades(conn, sid)
        if grades:
            averages.append(get_average(grades))

    if not averages:
        print("No grades available.")
        return

    highest = max(averages)
    lowest = min(averages)
    overall = sum(averages) / len(averages)

    print(f"Highest Average : {highest:.2f}")
    print(f"Lowest Average  : {lowest:.2f}")
    print(f"Class Average   : {overall:.2f}")


def honor_roll(conn):
    divider()
    print("HONOR ROLL")
    divider()

    cur = conn.cursor()
    cur.execute("SELECT id, name FROM students")
    students = cur.fetchall()

    found = False
    for sid, name in students:
        grades = fetch_student_grades(conn, sid)
        if grades:
            avg = get_average(grades)
            if avg >= 90:
                print(f"{sid:<8}{name:<25}{avg:.2f}")
                found = True

    if not found:
        print("No honor students found.")


